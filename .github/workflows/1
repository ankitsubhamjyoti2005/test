# .github/workflows/deploy-eks.yml
# Replaces the Jenkins "release / rollback / remove" Helm pipeline.

name: EKS Deploy (Helm)

run-name: "${{ inputs.ACTION }} ${{ inputs.APP_NAME }} → ${{ inputs.COUNTRY_CODE }}-${{ inputs.ENVIRONMENT }}"

on:
  workflow_dispatch:
    inputs:
      ACTION:
        description: "Operation to perform"
        type: choice
        options: [release, rollback, remove]
        default: release
      APP_NAME:
        description: "Service name (also the Helm release name)"
        type: string
        required: true
      COUNTRY_CODE:
        type: choice
        options: [us, in]
        default: us
      ENVIRONMENT:
        type: choice
        options: [dev, stage, prod]
        default: dev
      AWS_REGION:
        type: choice
        options: [us-east-1, ap-south-1]
        default: us-east-1
      AWS_ACCOUNT:
        description: "Account ID hosting the ECR repo"
        type: string
        required: true
      VERSION_BUCKET:
        description: "S3 bucket holding version.txt"
        type: string
        required: true
      REPLICA_COUNT:
        description: "hpa.minReplicas"
        type: string
        default: "1"
      GIT_BRANCH:
        description: "Branch/tag of alk-devops-infra to deploy from"
        type: string
        default: main
      RUNNER_LABEL:
        description: "Runner label. Must be a VPC-resident runner — the EKS API endpoint is private."
        type: string
        default: self-hosted

  # Lets service repos call this instead of copy-pasting it.
  workflow_call:
    inputs:
      ACTION:        { type: string, required: true }
      APP_NAME:      { type: string, required: true }
      COUNTRY_CODE:  { type: string, required: true }
      ENVIRONMENT:   { type: string, required: true }
      AWS_REGION:    { type: string, required: true }
      AWS_ACCOUNT:   { type: string, required: true }
      VERSION_BUCKET:{ type: string, required: true }
      REPLICA_COUNT: { type: string, required: false, default: "1" }
      GIT_BRANCH:    { type: string, required: false, default: main }
      RUNNER_LABEL:  { type: string, required: false, default: self-hosted }
    secrets:
      AWS_ROLE_ARN:      { required: true }
      INFRA_REPO_TOKEN:  { required: false }
      SLACK_WEBHOOK_URL: { required: false }

permissions:
  id-token: write      # required for OIDC role assumption
  contents: read

# Serialise deploys per app+env; queue rather than cancel mid-Helm.
concurrency:
  group: eks-deploy-${{ inputs.APP_NAME }}-${{ inputs.COUNTRY_CODE }}-${{ inputs.ENVIRONMENT }}
  cancel-in-progress: false

jobs:
  deploy:
    name: "${{ inputs.ACTION }} ${{ inputs.APP_NAME }}"
    runs-on: ${{ inputs.RUNNER_LABEL }}
    # Attach reviewers/wait timers to this environment for approval gating.
    environment: ${{ inputs.COUNTRY_CODE }}-${{ inputs.ENVIRONMENT }}
    env:
      NAMESPACE: ${{ inputs.APP_NAME }}-${{ inputs.COUNTRY_CODE }}-${{ inputs.ENVIRONMENT }}
      CLUSTER_NAME: eks-${{ inputs.COUNTRY_CODE }}-${{ inputs.ENVIRONMENT }}
      ECR_REPO: ${{ inputs.AWS_ACCOUNT }}.dkr.ecr.${{ inputs.AWS_REGION }}.amazonaws.com/${{ inputs.APP_NAME }}-${{ inputs.COUNTRY_CODE }}-${{ inputs.ENVIRONMENT }}
      SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}

    steps:
      - name: Checkout alk-devops-infra
        uses: actions/checkout@v4
        with:
          repository: XVISION-IT-PRIVATE-LIMITED/alk-devops-infra
          ref: ${{ inputs.GIT_BRANCH }}
          token: ${{ secrets.INFRA_REPO_TOKEN || github.token }}
          persist-credentials: false

      # Per-run kubeconfig + values path. Keeps concurrent runs on a
      # self-hosted runner from stomping on each other's context.
      - name: Prepare run paths
        run: |
          echo "KUBECONFIG=$RUNNER_TEMP/kubeconfig" >> "$GITHUB_ENV"
          echo "VALUES_FILE=$RUNNER_TEMP/values-${{ inputs.COUNTRY_CODE }}-${{ inputs.ENVIRONMENT }}.yaml" >> "$GITHUB_ENV"

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
          aws-region: ${{ inputs.AWS_REGION }}
          role-session-name: gha-${{ inputs.APP_NAME }}-${{ github.run_id }}

      - name: Install kubectl
        uses: azure/setup-kubectl@v4
        with:
          version: v1.30.4

      - name: Install Helm
        uses: azure/setup-helm@v4
        with:
          version: v3.16.3

      - name: Update kubeconfig
        run: |
          set -euo pipefail
          aws eks update-kubeconfig \
            --name "$CLUSTER_NAME" \
            --region "${{ inputs.AWS_REGION }}" \
            --alias "$CLUSTER_NAME"
          kubectl config use-context "$CLUSTER_NAME"
          kubectl version --output=yaml | head -n 20

      - name: Ensure namespace
        if: inputs.ACTION != 'remove'
        run: |
          kubectl create namespace "$NAMESPACE" --dry-run=client -o yaml | kubectl apply -f -

      - name: Fetch chart values from Secrets Manager
        if: inputs.ACTION == 'release'
        run: |
          set -euo pipefail
          umask 077
          aws secretsmanager get-secret-value \
            --secret-id "values-${{ inputs.COUNTRY_CODE }}-${{ inputs.ENVIRONMENT }}" \
            --region "${{ inputs.AWS_REGION }}" \
            --query SecretString --output text > "$VALUES_FILE"
          test -s "$VALUES_FILE"
          echo "values file written: $(wc -l < "$VALUES_FILE") lines"

      - name: Resolve app version
        if: inputs.ACTION == 'release'
        run: |
          set -euo pipefail
          aws s3 cp \
            "s3://${{ inputs.VERSION_BUCKET }}/${{ inputs.COUNTRY_CODE }}/${{ inputs.ENVIRONMENT }}/${{ inputs.APP_NAME }}/version.txt" \
            "$RUNNER_TEMP/version.txt"
          APP_VERSION="$(tr -d ' \r\n' < "$RUNNER_TEMP/version.txt")"
          if [[ ! "$APP_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            echo "::error::version.txt is not semver: '$APP_VERSION'"
            exit 1
          fi
          echo "APP_VERSION=$APP_VERSION" >> "$GITHUB_ENV"
          echo "deploying $APP_VERSION"

      - name: Set chart appVersion
        if: inputs.ACTION == 'release'
        run: |
          set -euo pipefail
          sed -i "s/^appVersion:.*/appVersion: ${APP_VERSION}/" helm/app/Chart.yaml
          cat helm/app/Chart.yaml

      - name: Helm release
        if: inputs.ACTION == 'release'
        run: |
          set -euo pipefail
          helm upgrade --install "${{ inputs.APP_NAME }}" helm/app \
            --namespace "$NAMESPACE" \
            --create-namespace \
            --set serviceName="${{ inputs.APP_NAME }}" \
            --set countryCode="${{ inputs.COUNTRY_CODE }}" \
            --set envName="${{ inputs.ENVIRONMENT }}" \
            --set image.repository="$ECR_REPO" \
            --set image.tag=latest \
            --set image.pullPolicy=Always \
            --set hpa.minReplicas="${{ inputs.REPLICA_COUNT }}" \
            --values "$VALUES_FILE" \
            --atomic --timeout 300s

          # Carried over from the Jenkins job. --atomic already waits for the
          # release to converge, so this is only needed while image.tag=latest.
          kubectl rollout restart deployment/"$NAMESPACE" -n "$NAMESPACE"
          kubectl rollout status  deployment/"$NAMESPACE" -n "$NAMESPACE" --timeout=180s

      - name: Helm rollback
        if: inputs.ACTION == 'rollback'
        run: |
          set -euo pipefail
          helm history "${{ inputs.APP_NAME }}" -n "$NAMESPACE" --max 10
          helm rollback "${{ inputs.APP_NAME }}" -n "$NAMESPACE" --wait --timeout 300s

      - name: Helm uninstall
        if: inputs.ACTION == 'remove'
        run: |
          set -euo pipefail
          helm uninstall "${{ inputs.APP_NAME }}" -n "$NAMESPACE" --wait --timeout 300s

      - name: Job summary
        if: always()
        run: |
          {
            echo "### ${{ inputs.ACTION }} — \`${{ inputs.APP_NAME }}\`"
            echo ""
            echo "| Field | Value |"
            echo "| --- | --- |"
            echo "| Cluster | \`$CLUSTER_NAME\` |"
            echo "| Namespace | \`$NAMESPACE\` |"
            echo "| Version | \`${APP_VERSION:-n/a}\` |"
            echo "| Branch | \`${{ inputs.GIT_BRANCH }}\` |"
            echo "| Result | ${{ job.status }} |"
          } >> "$GITHUB_STEP_SUMMARY"

      - name: Notify Slack
        if: always() && env.SLACK_WEBHOOK_URL != ''
        run: |
          set -euo pipefail
          payload=$(jq -n \
            --arg status "${{ job.status }}" \
            --arg action "${{ inputs.ACTION }}" \
            --arg app "${{ inputs.APP_NAME }}" \
            --arg ns "$NAMESPACE" \
            --arg version "${APP_VERSION:-n/a}" \
            --arg actor "${{ github.actor }}" \
            --arg url "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}" \
            '{
               channel: "#release-hub",
               attachments: [{
                 color: (if $status == "success" then "good" else "danger" end),
                 text: "*Deployment \($status)*\n*Action*: \($action)\n*App*: \($app)\n*Namespace*: \($ns)\n*Version*: \($version)\n*Triggered by*: \($actor)\n*Run*: <\($url)|Open>"
               }]
             }')
          curl -sS -X POST -H 'Content-type: application/json' --data "$payload" "$SLACK_WEBHOOK_URL"

      # Equivalent of cleanWs() — matters on self-hosted runners.
      - name: Clean up
        if: always()
        run: |
          rm -f "${VALUES_FILE:-}" "${KUBECONFIG:-}" "$RUNNER_TEMP/version.txt" || true
